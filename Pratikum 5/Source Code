# ==========================================
# 4. MENGHITUNG NILAI KEANGGOTAAN
# ==========================================

def hitung_keanggotaan(x, jenis, parameter):

    if jenis == "trapesium":
        return float(trapezoid(
            x,
            parameter[0],
            parameter[1],
            parameter[2],
            parameter[3]
        ))

    elif jenis == "segitiga":
        return float(triangle(
            x,
            parameter[0],
            parameter[1],
            parameter[2]
        ))

    return 0.0
# ==========================================
# 5. FUNGSI FUZZIFIKASI
# ==========================================

def fuzzifikasi(input_dict):

    hasil = {}

    for nama_variabel, nilai in input_dict.items():

        hasil[nama_variabel] = {}

        model = variabel[nama_variabel]

        for label, (jenis, parameter) in model["fungsi"].items():

            nilai_mu = hitung_keanggotaan(
                nilai,
                jenis,
                parameter
            )

            hasil[nama_variabel][label] = round(
                nilai_mu,
                3
            )

    return hasil
# ==========================================
# 6. FUNGSI VISUALISASI
# ==========================================

def plot_variabel(nama_variabel):

    model = variabel[nama_variabel]

    batas_bawah, batas_atas = model["semesta"]

    x = np.linspace(
        batas_bawah,
        batas_atas,
        500
    )

    plt.figure(figsize=(9, 5))

    for label, (jenis, parameter) in model["fungsi"].items():

        if jenis == "trapesium":

            y = trapezoid(
                x,
                parameter[0],
                parameter[1],
                parameter[2],
                parameter[3]
            )

        elif jenis == "segitiga":

            y = triangle(
                x,
                parameter[0],
                parameter[1],
                parameter[2]
            )

        plt.plot(
            x,
            y,
            linewidth=2,
            label=label
        )

    plt.title(
        f"Fungsi Keanggotaan {nama_variabel.replace('_', ' ').title()}"
    )

    plt.xlabel(
        f"Nilai ({model['satuan']})"
    )

    plt.ylabel(
        "Derajat Keanggotaan"
    )

    plt.ylim(0, 1.05)
    plt.xlim(batas_bawah, batas_atas)

    plt.grid(True, alpha=0.3)
    plt.legend()

    nama_file = f"{nama_variabel}.png"

    plt.savefig(
        nama_file,
        dpi=300,
        bbox_inches="tight"
    )

    plt.show()

    print(f"Grafik berhasil disimpan: {nama_file}")

# ==========================================
# 7. MENAMPILKAN GRAFIK
# ==========================================

plot_variabel("latensi")
plot_variabel("packet_loss")
plot_variabel("kualitas_jaringan")

