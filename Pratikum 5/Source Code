import numpy as np
import matplotlib.pyplot as plt
# ==========================================
# 1. FUNGSI KEANGGOTAAN TRAPESIUM
# ==========================================
def trapezoid(x, a, b, c, d):
    x = np.asarray(x)

    return np.maximum(
        np.minimum(
            np.minimum(
                (x - a) / (b - a) if b != a else 1,
                1
            ),
            (d - x) / (d - c) if d != c else 1
        ),
        0
    )
# ==========================================
# 2. FUNGSI KEANGGOTAAN SEGITIGA
# ==========================================

def triangle(x, a, b, c):
    x = np.asarray(x)

    return np.maximum(
        np.minimum(
            (x - a) / (b - a),
            (c - x) / (c - b)
        ),
        0
    )

