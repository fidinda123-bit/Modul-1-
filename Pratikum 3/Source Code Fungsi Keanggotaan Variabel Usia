import numpy as np
import matplotlib.pyplot as plt
# Fungsi keanggotaan trapesium
def trapezoid(x, a, b, c, d):
return np.maximum(
np.minimum(
np.minimum((x - a) / (b - a), 1),
(d - x) / (d - c)
),
0
)
# Rentang usia
x = np.linspace(0, 80, 1000)
# Parameter masing-masing kategori
bayi = trapezoid(x, 0, 2, 3, 5)
anak = trapezoid(x, 6, 8, 9, 11)
remaja = trapezoid(x, 10, 14, 15, 19)
pemuda = trapezoid(x, 15, 19, 20, 24)
dewasa = trapezoid(x, 20, 42, 43, 65)
lansia = trapezoid(x, 60, 69, 71, 80)
# Grafik gabungan
plt.figure(figsize=(12, 6))
plt.plot(x, bayi, label='Bayi')
plt.plot(x, anak, label='Anak-anak')
plt.plot(x, remaja, label='Remaja')
plt.plot(x, pemuda, label='Pemuda')
plt.plot(x, dewasa, label='Dewasa')
plt.plot(x, lansia, label='Lansia')

plt.xlabel('Usia')
plt.ylabel('Derajat Keanggotaan μ(x)')
plt.title('Grafik Fungsi Keanggotaan Variabel Usia')
plt.ylim(0, 1.1)
plt.xlim(0, 80)
plt.grid(True)
plt.legend()
plt.show()

