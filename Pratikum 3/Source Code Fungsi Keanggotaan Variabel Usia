# 1. FUNGSI KEANGGOTAAN BAYI
# Parameter: (0, 2, 3, 5)
# ==========================================

def fungsi_bayi_naik(x):
    a, b = 0, 2

    if x < a or x > b:
        return 0
    elif a <= x < b:
        return (x - a) / (b - a)
    else:
        return 1


def fungsi_bayi_turun(x):
    c, d = 3, 5

    if x < c or x > d:
        return 0
    elif c < x <= d:
        return (d - x) / (d - c)
    else:
        return 1

