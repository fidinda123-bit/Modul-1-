import numpy as np
import matplotlib.pyplot as plt
# 1. FUNGSI LOGIKA CRISP
def crisp_kritis(waktu):
"""
Fungsi Crisp:
Jika waktu tunggu >= 8 jam, maka tiket kritis = 1.
Jika waktu tunggu < 8 jam, maka tiket kritis = 0.
"""
return np.where(waktu >= 8, 1.0, 0.0)
# 2. FUNGSI KEANGGOTAAN FUZZY
def fuzzy_kritis(waktu):
"""
Fungsi Fuzzy linear naik:
x < 4 -> derajat 0
4 <= x <= 12 -> (x - 4) / 8
x > 12 -> derajat 1
"""
derajat = (waktu - 4) / 8
return np.clip(derajat, 0.0, 1.0)
# 3. DATA PENGUJIAN
data_uji = np.array([
2, 4, 6, 7.9, 8.0,
8.1, 10, 12, 16, 24
])
# 4. PERHITUNGAN CRISP DAN FUZZY
hasil_crisp = crisp_kritis(data_uji)
hasil_fuzzy = fuzzy_kritis(data_uji)
# 5. MENAMPILKAN TABEL HASIL
print("=" * 60)
print("SISTEM PRIORITAS TIKET HELPDESK TI")
print("PERBANDINGAN LOGIKA CRISP DAN FUZZY")
print("=" * 60)
print(f"{'Waktu (jam)':<15}{'Crisp':<15}{'Fuzzy μ(x)':<15}")
print("-" * 45)
for waktu, crisp, fuzzy in zip(data_uji, hasil_crisp, hasil_fuzzy):
print(f"{waktu:<15.1f}{crisp:<15.1f}{fuzzy:<15.4f}")
# 6. DATA UNTUK GRAFIK
x = np.linspace(0, 24, 500)
y_crisp = crisp_kritis(x)
y_fuzzy = fuzzy_kritis(x)
# 7. MEMBUAT GRAFIK
plt.figure(figsize=(10, 6))
# Grafik Crisp
plt.step(
x,
y_crisp,
where='post',
label='Crisp (Batas = 8 jam)',
linewidth=2.5
)
# Grafik Fuzzy
plt.plot(
x,
y_fuzzy,
label='Fuzzy (Transisi 4–12 jam)',
linewidth=2.5
)
# Titik data pengujian
plt.scatter(
data_uji,
hasil_crisp,
s=50,
label='Data Crisp'
)
plt.scatter(
data_uji,
hasil_fuzzy,
s=50,
label='Data Fuzzy'
)
# Garis batas Crisp
plt.axvline(
x=8,
linestyle='--',
linewidth=1.5,
label='Batas Crisp = 8 jam'
)
# Garis batas Fuzzy
plt.axvline(
x=4,
linestyle=':',
linewidth=1.5,
label='Awal Fuzzy = 4 jam'
)
plt.axvline(
x=12,
linestyle=':',
linewidth=1.5,
label='Akhir Fuzzy = 12 jam'
)
# 8. LABEL GRAFIK
plt.title(
'Perbandingan Logika Crisp dan Fuzzy\n'
'Sistem Prioritas Tiket Helpdesk TI'
)
plt.xlabel('Waktu Tunggu Tiket (Jam)')
plt.ylabel('Derajat Keanggotaan / Nilai Kebenaran')
plt.xlim(0, 24)
plt.ylim(-0.05, 1.1)
plt.grid(True, linestyle=':', alpha=0.6)
plt.legend()
plt.tight_layout()
# 9. MENYIMPAN GRAFIK
plt.savefig(
'grafik_crisp_vs_fuzzy_helpdesk.png',
dpi=300
)
plt.show()
